<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FE">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:srcCompat="@android:drawable/ic_dialog_email"
                app:tint="#093C98"
                android:importantForAccessibility="no"
            />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="消息"
                android:textColor="#093C98"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_header_unread_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_unread_badge"
                android:gravity="center"
                android:minWidth="22dp"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="0"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:importantForAccessibility="no"
                android:accessibilityHeading="true"
            />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_unread_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_message_banner"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:contentDescription="@string/cd_row_community"
            android:focusable="true"
        >

            <TextView
                android:id="@+id/tv_unread_summary_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="有新消息在等你"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:accessibilityHeading="true"
            />

            <TextView
                android:id="@+id/tv_unread_summary_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="买卖双方的新动态会第一时间出现在这里。"
                android:textColor="#E7F2FF"
                android:textSize="13sp"
                android:accessibilityHeading="true"
            />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_summary_unread_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_field"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="未读 0"
                    android:textColor="@color/primary_blue"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:accessibilityLiveRegion="polite"
                />

                <TextView
                    android:id="@+id/tv_summary_buy_sell"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_field"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="买入 0 · 卖出 0"
                    android:textColor="@color/primary_blue"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_summary_toggle_unread"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_field"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="只看未读"
                    android:textColor="@color/primary_blue"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:focusable="true"
                />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_post_input_soft"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                app:srcCompat="@android:drawable/ic_menu_search"
                app:tint="#8F95B2"
                android:importantForAccessibility="no"
            />

            <EditText
                android:id="@+id/et_message_search"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:hint="搜索聊天对象、商品或消息内容..."
                android:textColor="#191B25"
                android:textColorHint="#999EAE"
                android:textSize="14sp"
                android:nextFocusForward="@+id/tab_all"
            />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tab_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:text="全部消息"
                android:textColor="#093C98"
                android:textSize="14sp"
                android:textStyle="bold"
                android:focusable="true"
            />

            <TextView
                android:id="@+id/tab_buying"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:text="买入"
                android:textColor="#8F95B2"
                android:textSize="14sp"
                android:textStyle="bold"
                android:focusable="true"
            />

            <TextView
                android:id="@+id/tab_selling"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="卖出"
                android:textColor="#8F95B2"
                android:textSize="14sp"
                android:textStyle="bold"
                android:focusable="true"
            />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_conversations"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="96dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/tv_message_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:paddingHorizontal="32dp"
                android:paddingVertical="24dp"
                android:text="暂时还没有会话。"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:visibility="gone"
                android:accessibilityLiveRegion="polite"
            />

            <ProgressBar
                android:id="@+id/progress_message"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/primary_blue"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/fab_new_message"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_post_publish_button"
        android:elevation="6dp"
        android:padding="16dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_nav_post_plus"
        app:tint="#FFFFFF"
        android:contentDescription="@string/cd_new_message"
        android:focusable="true"
    />

</FrameLayout>
