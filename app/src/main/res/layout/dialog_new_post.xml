<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="8dp">

    <EditText
        android:id="@+id/et_post_content"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@drawable/bg_auth_input"
        android:gravity="start|top"
        android:hint="分享你的校园生活、二手好物心得…"
        android:inputType="textMultiLine"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:nextFocusForward="@+id/tv_select_post_image"
    />

    <TextView
        android:id="@+id/tv_select_post_image"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_auth_light_button"
        android:gravity="center"
        android:text="添加配图"
        android:textColor="@color/primary_blue"
        android:textSize="14sp"
        android:textStyle="bold"
        android:focusable="true"
    />

    <ImageView
        android:id="@+id/iv_selected_post_image"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_image_placeholder"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="@string/cd_selected_post_image"
        android:focusable="true"
    />
</LinearLayout>
