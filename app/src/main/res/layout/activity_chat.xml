<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_soft"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <TextView
            android:id="@+id/btn_chat_back"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_chip_inactive"
            android:gravity="center"
            android:text="返"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:contentDescription="@string/cd_back"
            android:focusable="true"
        />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_chat_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_chat_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:accessibilityHeading="true"
            />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_chat_more"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_chip_inactive"
            android:gravity="center"
            android:text="更多"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:contentDescription="@string/cd_more_chat"
            android:focusable="true"
        />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/bg_message_context"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_image_placeholder"
            android:gravity="center"
            android:text="商品"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_chat_item_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:accessibilityHeading="true"
            />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="可继续沟通价格、地点和取货时间"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_chat_price"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_verified_pill"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:textColor="@color/accent_teal_dark"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_chat_messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="14dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/tv_chat_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="24dp"
            android:text="还没有历史消息，现在发第一句和对方打个招呼吧。"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone"
            android:focusable="true"
            android:accessibilityLiveRegion="polite"
        />

        <ProgressBar
            android:id="@+id/progress_chat"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/primary_blue"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:background="@drawable/bg_bottom_nav"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp">

        <EditText
            android:id="@+id/et_chat_input"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/bg_message_input"
            android:hint="输入消息..."
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textShortMessage"
            android:paddingHorizontal="18dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:nextFocusForward="@+id/btn_send_message"
        />

        <TextView
            android:id="@+id/btn_send_message"
            android:layout_width="64dp"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_primary_gradient"
            android:gravity="center"
            android:text="发送"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:focusable="true"
        />
    </LinearLayout>
</LinearLayout>
